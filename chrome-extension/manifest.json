{
  "manifest_version": 3,
  "name": "Accesos Empresariales Bot",
  "version": "1.0",
  "description": "Auto-login seguro para portales del SRI e IESS",
  "permissions": [
    "tabs",
    "cookies",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://nextjs-boilerplate-*.vercel.app/*",
    "https://srienlinea.sri.gob.ec/*",
    "https://www.iess.gob.ec/*",
    "https://*.contifico.com/*",
    "https://*.siigo.com/*",
    "https://*.perseo.app/*",
    "https://*.perseoweb.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://srienlinea.sri.gob.ec/*", 
        "https://www.iess.gob.ec/*",
        "https://*.contifico.com/*",
        "https://*.siigo.com/*",
        "https://*.perseo.app/*",
        "https://*.perseoweb.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:3000/*",
        "https://nextjs-boilerplate-*.vercel.app/*"
      ],
      "js": ["dashboard-content.js"],
      "run_at": "document_start"
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "https://nextjs-boilerplate-*.vercel.app/*"
    ]
  }
}
