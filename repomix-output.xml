                placeholder="Ingresa tu usuario"
                className="w-full px-4 py-3 rounded-xl border-2 focus:outline-none transition-all"
                style={{
                  borderColor: theme.border,
                  background: isDark ? '#0f1419' : '#fff',
                  color: theme.text,
                }}
                required
