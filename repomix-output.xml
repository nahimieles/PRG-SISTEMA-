                                </div>
                            );
                        })}
                    </div>
                )}
            </div>

            {/* Bottom pagination */}
            {events.length > 0 && (
                <div style={{ borderTop: `1px solid ${theme.border}` }}>
                    <PaginationBlock />
                </div>
            )}

            <style>{`
                @keyframes rtmFadeIn {
                    from { opacity: 0; transform: translateY(-4px); }
